# Copy to .env and fill in, or export these directly in the shell that
# starts the server. Petri does not load .env automatically — either export
# the variables yourself or use a loader such as `direnv`.

# Optional. Enables the "Analyze" button, which sends MultiQC summary
# statistics to the Anthropic API for a plain-English interpretation.
# Without it the server runs normally and the analyze endpoint returns 503.
ANTHROPIC_API_KEY=sk-ant-...
