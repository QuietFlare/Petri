// plugins.config, Nextflow plugins for every pipeline run Petri launches.
//
// Why this exists:
//   Petri starts Nextflow as a subprocess. Nextflow accepts multiple `-c`
//   config files and merges them in order, so the server passes this file
//   (alongside the lineage config) on every run. Adding a plugin here means
//   every dashboard-launched run picks it up; deleting this file (or the
//   entries below) turns plugins off, no server change needed either way.
//
// Currently configured:
//   nf-runinsights, records per-process runtime/memory for each run in a
//   local history store, compares each run against previous runs of the same
//   pipeline, and flags regressions and over-provisioned resources. Resolved
//   from the Nextflow plugin registry (registry.nextflow.io); a local dev
//   build installed via `./gradlew install` takes precedence when present.
//   It only observes: it cannot alter or fail a run.

plugins {
    id 'nf-runinsights@0.1.0'
}

// Where run history accumulates: a DIRECTORY holding one JSON file per run.
// All Petri runs share it, so comparisons work across dashboard runs. This is
// also the plugin's default; stated explicitly so it's visible and easy to
// change. For team or cloud setups point it at a shared location instead -
// every launch host then contributes to the same history:
//   history = '/shared/projects/my-team/runinsights'
//   history = 's3://my-lab-bucket/runinsights'
// (An old single-file history.jsonl next to the directory is still read.)
runinsights {
    history = "${System.getProperty('user.home')}/.nf-runinsights/history"

    // AI narration: uncomment to add an "## AI analysis" section to each
    // run's report. Needs ANTHROPIC_API_KEY exported in the shell the Petri
    // server starts from (the Nextflow subprocess inherits it). Best-effort:
    // any failure leaves the deterministic report untouched.
    // ai { enabled = true }
}
